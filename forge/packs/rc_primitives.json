{
  "collection": "RC_Primitives",
  "credit": "Deluxe Primitives by Reactorcore (http://www.reactorcoregames.com), CC-BY 4.0. Standardised for Asset Forge by forge/import_collection.py.",
  "scale": 0.5,
  "strip_prefix": "mesh_",
  "pad": 2,
  "rename": {
    "D20": "icosphere_0020",
    "D80": "icosphere_0080",
    "D320": "icosphere_0320",
    "D1280": "icosphere_1280",
    "D1280_MirroredUV": "icosphere_1280_mirrored_uv",
    "D5120_MirroredUV": "icosphere_5120_mirrored_uv",
    "Plane_doublesided": "plane_vertical_doublesided"
  },
  "slots": {
    "base": "#D0D0D0",
    "inner": "#707070",
    "ground": "#A0A0A0"
  },
  "slot_rules": [
    {"match": "_internal$", "slot": "inner", "faces": "all"},
    {"match": "^(Plane|Triangle)_doublesided$", "slot": "inner", "faces": "back", "axis": "auto"},
    {"match": "_doublesided$", "slot": "inner", "faces": "inward"},
    {"match": "^Hill\\d+$", "slot": "ground", "faces": "flat_at", "level": "min"},
    {"match": "^Pit\\d+$", "slot": "ground", "faces": "flat_at", "level": "max"}
  ],
  "pieces": [
    {"match": "^(FlatPyramid|StepPyramid)_", "src_offset": [0.018, 0, 0.07], "note": "authoring offset, snap onto the axis"},
    {"match": "^Container6$", "align": {"x": "centre", "z": "centre"}, "note": "irregular chunk, no axis"},
    {"match": "^Pit\\d+$", "align": {"y": "max"}, "note": "rim at y=0, flush with Hill tiles"},
    {"match": "^HalfPipeEnd$", "align": {"z": "max"}, "note": "fills the back half of its cell, caps a half_pipe one cell behind"},
    {"match": "^(DomeHalf|DomeQuarter|RingHalf|RingQuarter)_|^Frame[67]_(half|quarter)$", "yaw": 180, "note": "halves on +z, quarters at (-x,+z) like cylinder_half / sphere_quarter"},
    {"match": "^Ramp[15]$", "yaw": -90, "note": "high side to -z like wedge"},
    {"match": "^RampRound10$", "yaw": 180, "note": "high side to -z like halfPipe_half"},
    {"match": "^RampRound9$", "yaw": -90, "note": "high corner to (-x,-z) like wedge_corner*"},
    {"match": "^RampRound7$", "yaw": 90, "note": "half-bowls on +z like RampRound5"},
    {"match": "^Ramp2$", "yaw": 90, "note": "ridge along x like roof"},
    {"match": "^HalfPipe$", "yaw": 90, "note": "channel along z like the built-in halfPipe and HalfPipeEnd"}
  ]
}
